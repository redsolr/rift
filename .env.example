# --- Database (the arena ladder is the only persistent state) --------------
# Local: docker compose up -d (postgres on 5441 — 5432/5433/5439/5440 are taken by the other portfolio apps).
# Prod: the POOLED Neon URL, set only in Vercel; `vercel-build` runs the migrations against the direct endpoint.
DATABASE_URL=postgresql://rift:rift@localhost:5441/rift
